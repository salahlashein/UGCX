# Copy to .env.local for local development. Set the same names in Vercel.

# The API base URL. Leave empty locally to use the /api/v1 proxy.
NEXT_PUBLIC_API_URL=

# Manual payment payees shown on the brief funding page.
# A payee without a value is not offered to brands.
NEXT_PUBLIC_INSTAPAY_ADDRESS=
NEXT_PUBLIC_VODAFONE_CASH_NUMBER=

# Set to "true" only when Paymob is live.
NEXT_PUBLIC_PAYMOB_ENABLED=false
